{
  "name": "marlin",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "mygo dev",
    "build": "bun run build:host && mygo build",
    "build:host": "cargo build --release --manifest-path host-bin/Cargo.toml && cp host-bin/target/release/marlin-host resources/darwin-arm64/marlin-host",
    "generate": "mygo generate",
    "dev:web": "vite",
    "build:web": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "marked": "^18.2.0",
    "mygo-runtime": "^0.9.0"
  },
  "devDependencies": {
    "mygo-cli": "^0.9.0",
    "typescript": "^7",
    "vite": "^8"
  }
}
